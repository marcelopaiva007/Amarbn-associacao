# Copie este arquivo para .env e preencha com os valores reais.
# O .env é ignorado pelo git — nenhuma senha deve voltar para o repositório.

# Connection string do PostgreSQL (Neon), com pooler habilitado.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/amarbn?sslmode=require"

# Chave usada para assinar o cookie de sessão. Mínimo de 32 caracteres.
# Gere uma com: openssl rand -base64 48
APP_SESSION_SECRET=""

# Credenciais do administrador criadas por `npm run db:seed`.
# Se ADMIN_PASSWORD ficar em branco, o seed sorteia uma senha e mostra no terminal.
ADMIN_EMAIL="admin@amarbn.org.br"
ADMIN_NAME="Administrador AMARBN"
ADMIN_PASSWORD=""
